@using BigTask.Models

<form method="post" asp-controller="SupplyCategories" asp-action="Review">
    <div>
        <h3>Graduation Certificates</h3>

        @foreach (SupplyCategories record in ViewBag.Records)
        {
            if (record.Category == "Graduation Certificates")
            {
                <div>
                    <input type="radio" name="Certificates" value="@record.Supplier" required/>
                    <label>@record.Supplier - @record.Offer - Quantity: @record.Quantity @record.UnitPrices JD</label>
                </div>
            }
        }
    </div>

    <div>
        <h3>Hospitality</h3>

        @foreach (SupplyCategories record in ViewBag.Records)
        {
            if (record.Category == "Hospitality")
            {
                <div>
                    <input type="radio" name="Hospitality" value="@record.Supplier" required/>
                    <label>@record.Supplier - @record.Offer - Quantity: @record.Quantity @record.UnitPrices JD</label>
                </div>
            }
        }
    </div>

    <div>
        <h3>Graduation Gifts</h3>

        @foreach (SupplyCategories record in ViewBag.Records)
        {
            if (record.Category == "Graduation Gifts")
            {
                <div>
                    <input type="radio" name="Gifts" value="@record.Supplier" required />
                    <label>@record.Supplier - @record.Offer - Quantity: @record.Quantity @record.UnitPrices JD</label>
                </div>
            }
        }
    </div>

    <button type="submit">Submit</button>
</form>